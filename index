    <script>
        // ============================================================
        // JOGO CORRIGIDO - MUDANÇA DE FASE FUNCIONA
        // ============================================================

        // ===== PERSONAGENS =====
        const CHARACTERS = {
            fifi: { name: 'Fifi', emoji: '🐕', speed: 5.2, jumpPower: 27, attack: 30 },
            spyke: { name: 'Spyke', emoji: '🐩', speed: 6.8, jumpPower: 29, attack: 25 },
            sansao: { name: 'Sansão', emoji: '🐕‍🦺', speed: 4.8, jumpPower: 25, attack: 40 },
            pretinha: { name: 'Pretinha', emoji: '🐕', speed: 6.5, jumpPower: 30, attack: 26 },
            amora: { name: 'Amora', emoji: '🐩', speed: 5.0, jumpPower: 26, attack: 22 },
            toto: { name: 'Totó', emoji: '🐕', speed: 5.4, jumpPower: 28, attack: 28 },
            benjamim: { name: 'Benjamim', emoji: '🐱', speed: 5.8, jumpPower: 29, attack: 30 },
            safira: { name: 'Safira', emoji: '🐈‍⬛', speed: 5.8, jumpPower: 31, attack: 32 },
            peludinho: { name: 'Peludinho', emoji: '🐱', speed: 4.8, jumpPower: 25, attack: 24 },
            zarolho: { name: 'Zarolho', emoji: '😺', speed: 5.5, jumpPower: 27.5, attack: 27 }
        };

        const DEFAULT_CONTROLS = { moveLeft: 'ArrowLeft', moveRight: 'ArrowRight', jump: ' ', pause: 'p', memory: 'm',
            run: 'Shift' };

        // ===== ÁUDIO =====
        class AudioManager {
            constructor() {
                this.ctx = null;
                this.muted = false;
                try { this.ctx = new(window.AudioContext || window.webkitAudioContext)(); } catch (e) { this.ctx = null; }
            }
            toggleMute() { this.muted = !this.muted; return this.muted; }
            playTone(freq, dur, type = 'sine', vol = 0.3) {
                if (this.muted || !this.ctx) return;
                try {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = type;
                    osc.frequency.value = freq;
                    gain.gain.setValueAtTime(vol, this.ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + dur);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start();
                    osc.stop(this.ctx.currentTime + dur);
                } catch (e) {}
            }
            collectBone() { this.playTone(600, 0.15, 'square', 0.2); }
            collectCoin() { this.playTone(880, 0.15, 'sine', 0.25); }
            collectHeart() { this.playTone(1200, 0.3, 'sine', 0.3); }
            enemyKilled() { this.playTone(300, 0.2, 'sawtooth', 0.2);
                setTimeout(() => this.playTone(500, 0.2, 'sawtooth', 0.2), 150); }
            victory() { [523, 659, 784, 1047].forEach((f, i) => setTimeout(() => this.playTone(f, 0.3, 'sine', 0.25), i *
                    200)); }
            jump() { this.playTone(400, 0.1, 'sine', 0.15); }
            hurt() { this.playTone(200, 0.3, 'sawtooth', 0.3); }
        }

        // ===== SETTINGS =====
        class SettingsManager {
            constructor() {
                this.audio = new AudioManager();
                this.controls = this.loadControls();
                this.stats = this.loadStats();
                this.unlocked = this.loadUnlocked();
            }
            loadControls() { const s = localStorage.getItem('controls'); return s ? JSON.parse(s) : { ...DEFAULT_CONTROLS }; }
            saveControls(c) { this.controls = c;
                localStorage.setItem('controls', JSON.stringify(c)); }
            loadStats() {
                const s = localStorage.getItem('stats');
                return s ? JSON.parse(s) : { totalBones: 0, totalCoins: 0, totalHearts: 0, totalKills: 0, maxPhase: 1 };
            }
            saveStats(s) { this.stats = s;
                localStorage.setItem('stats', JSON.stringify(s)); }
            loadUnlocked() { const s = localStorage.getItem('unlocked'); return s ? JSON.parse(s) : ['fifi']; }
            unlock(c) { if (!this.unlocked.includes(c)) { this.unlocked.push(c);
                    localStorage.setItem('unlocked', JSON.stringify(this.unlocked)); } }
            clearAll() { localStorage.clear();
                location.reload(); }
        }

        const settings = new SettingsManager();

        // ============================================================
        // CENÁRIO
        // ============================================================
        class Scenario {
            constructor(canvas) {
                this.canvas = canvas;
                this.ctx = canvas.getContext('2d');
                this.time = 0;
                this.clouds = [];
                this.trees = [];
                this.pineTrees = [];
                this.rocks = [];
                this.mushrooms = [];
                this.logs = [];
                this.bushes = [];
                this.flowers = [];
                this.birds = [];
                this.butterflies = [];
                this.particles = [];
                this.mountains = [
                    { color: 'rgba(60,120,60,0.12)', speed: 0.02, offset: 0 },
                    { color: 'rgba(40,100,40,0.08)', speed: 0.04, offset: 0.5 }
                ];
                const W = canvas.width || window.innerWidth;
                const H = canvas.height || window.innerHeight;
                const worldW = W * 2;
                const groundY = H - 30;
                for (let i = 0; i < 10; i++) {
                    this.clouds.push({ x: Math.random() * worldW, y: 20 + Math.random() * 120, w: 100 + Math.random() * 200,
                        speed: 0.2 + Math.random() * 0.5, opacity: 0.4 + Math.random() * 0.5 });
                }
                for (let i = 0; i < 20; i++) {
                    this.trees.push({ x: Math.random() * worldW, size: 40 + Math.random() * 60, shade: 0.7 + Math.random() *
                            0.3 });
                }
                for (let i = 0; i < 12; i++) {
                    this.pineTrees.push({ x: Math.random() * worldW, size: 30 + Math.random() * 40, shade: 0.6 + Math
                            .random() * 0.4 });
                }
                for (let i = 0; i < 25; i++) {
                    this.rocks.push({ x: Math.random() * worldW, y: groundY - 5 - Math.random() * 20, size: 6 + Math.random() *
                            14, color: `hsl(40, ${10+Math.random()*20}%, ${40+Math.random()*30}%)` });
                }
                for (let i = 0; i < 12; i++) {
                    this.mushrooms.push({ x: Math.random() * worldW, y: groundY - 5 - Math.random() * 15, size: 8 + Math
                            .random() * 12, color: `hsl(${20+Math.random()*30}, 70%, ${50+Math.random()*30}%)` });
                }
                for (let i = 0; i < 12; i++) {
                    this.logs.push({ x: Math.random() * worldW, y: groundY - 3 - Math.random() * 10, w: 20 + Math.random() *
                            50, h: 6 + Math.random() * 10, color: `hsl(30, ${30+Math.random()*30}%, ${25+Math.random()*20}%)` });
                }
                for (let i = 0; i < 20; i++) {
                    this.bushes.push({ x: Math.random() * worldW, y: groundY - 4 - Math.random() * 15, size: 15 + Math
                            .random() * 30, shade: 0.6 + Math.random() * 0.4 });
                }
                for (let i = 0; i < 80; i++) {
                    this.flowers.push({ x: Math.random() * worldW, y: groundY - 2 - Math.random() * 25, color: [
                            '#ff6b6b', '#ffd93d', '#6bcb77', '#4d96ff', '#ff6bff', '#ff9f43', '#a29bfe', '#fd79a8'
                        ][Math.floor(Math.random() * 8)], size: 3 + Math.random() * 6 });
                }
                for (let i = 0; i < 6; i++) {
                    this.birds.push({ x: Math.random() * worldW, y: 50 + Math.random() * 100, speed: 0.5 + Math.random() *
                            1.5, flap: 0 });
                }
                for (let i = 0; i < 10; i++) {
                    this.butterflies.push({ x: Math.random() * worldW, y: 100 + Math.random() * 200, speed: 0.3 + Math
                            .random() * 0.8, phase: Math.random() * 6.28, color: ['#ff6b6b', '#ffd93d', '#6bcb77',
                            '#4d96ff', '#ff6bff'
                        ][Math.floor(Math.random() * 5)] });
                }
            }

            update() {
                this.time += 0.01;
                for (const c of this.clouds) { c.x += c.speed; if (c.x > this.canvas.width * 2 + c.w) c.x = -c.w; }
                for (const b of this.birds) { b.x += b.speed;
                    b.flap += 0.1; if (b.x > this.canvas.width * 2) b.x = -20; }
                for (const b of this.butterflies) { b.x += Math.sin(this.time * 0.5 + b.phase) * 0.5;
                    b.y += Math.sin(this.time * 0.7 + b.phase) * 0.3; }
                if (this.particles.length < 40) {
                    this.particles.push({
                        x: Math.random() * this.canvas.width * 2,
                        y: this.canvas.height - 25 - Math.random() * 10,
                        size: 1 + Math.random() * 3,
                        life: 50 + Math.random() * 50,
                        maxLife: 100,
                        vx: (Math.random() - 0.5) * 0.2,
                        vy: -0.1 - Math.random() * 0.2
                    });
                }
                for (const p of this.particles) {
                    p.x += p.vx;
                    p.y += p.vy;
                    p.life--;
                    if (p.life <= 0) { p.x = Math.random() * this.canvas.width * 2;
                        p.y = this.canvas.height - 25 - Math.random() * 10;
                        p.life = 50 + Math.random() * 50; }
                }
            }

            draw(camX, camY) {
                const ctx = this.ctx;
                const W = this.canvas.width;
                const H = this.canvas.height;
                const groundY = H - 30;

                if (W === 0 || H === 0) return;

                const skyGrad = ctx.createLinearGradient(0, 0, 0, groundY);
                skyGrad.addColorStop(0, '#5ba3d0');
                skyGrad.addColorStop(0.35, '#87CEEB');
                skyGrad.addColorStop(0.65, '#b8e6f0');
                skyGrad.addColorStop(0.85, '#d4f0d4');
                skyGrad.addColorStop(1, '#c8e6a0');
                ctx.fillStyle = skyGrad;
                ctx.fillRect(0, 0, W, groundY);

                const sunX = W - 100 - camX * 0.05;
                const sunY = 80 + Math.sin(this.time * 0.2) * 5;
                ctx.fillStyle = 'rgba(255,200,50,0.6)';
                ctx.beginPath();
                ctx.arc(sunX, sunY, 60, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = 'rgba(255,220,80,0.8)';
                ctx.beginPath();
                ctx.arc(sunX, sunY, 40, 0, Math.PI * 2);
                ctx.fill();
                ctx.fillStyle = 'rgba(255,240,150,0.9)';
                ctx.beginPath();
                ctx.arc(sunX, sunY, 25, 0, Math.PI * 2);
                ctx.fill();

                for (const layer of this.mountains) {
                    const offsetX = camX * layer.speed;
                    ctx.fillStyle = layer.color;
                    ctx.beginPath();
                    ctx.moveTo(0, groundY);
                    for (let x = 0; x <= W; x += 5) {
                        const y = groundY - 30 - Math.sin(x * 0.005 + layer.offset + 1) * 25 -
                            Math.sin(x * 0.008 + layer.offset + 3) * 15 -
                            Math.sin(x * 0.012 + layer.offset + 5) * 10;
                        ctx.lineTo(x, y);
                    }
                    ctx.lineTo(W, groundY);
                    ctx.fill();
                }

                for (const cloud of this.clouds) {
                    const cx = cloud.x - camX * 0.3;
                    const cy = cloud.y - camY * 0.1;
                    ctx.fillStyle = `rgba(255,255,255,${cloud.opacity})`;
                    const w = cloud.w,
                        h = w * 0.3;
                    ctx.beginPath();
                    ctx.ellipse(cx, cy + h * 0.3, w * 0.4, h * 0.6, 0, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.beginPath();
                    ctx.ellipse(cx + w * 0.2, cy, w * 0.3, h * 0.7, 0, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.beginPath();
                    ctx.ellipse(cx - w * 0.15, cy + h * 0.1, w * 0.25, h * 0.5, 0, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.beginPath();
                    ctx.ellipse(cx + w * 0.35, cy + h * 0.2, w * 0.2, h * 0.4, 0, 0, Math.PI * 2);
                    ctx.fill();
                }

                for (const bird of this.birds) {
                    const bx = bird.x - camX * 0.2;
                    const by = bird.y - camY * 0.05;
                    ctx.fillStyle = '#333';
                    const flap = Math.sin(bird.flap) * 4;
                    ctx.beginPath();
                    ctx.moveTo(bx, by);
                    ctx.quadraticCurveTo(bx - 8, by - 6 + flap, bx - 16, by + flap);
                    ctx.quadraticCurveTo(bx - 8, by + 4 + flap, bx, by);
                    ctx.quadraticCurveTo(bx + 8, by + 4 + flap, bx + 16, by + flap);
                    ctx.quadraticCurveTo(bx + 8, by - 6 + flap, bx, by);
                    ctx.fill();
                }

                for (const tree of this.trees) {
                    const x = tree.x - camX * 0.2;
                    const size = tree.size;
                    const shade = tree.shade;
                    ctx.fillStyle = `rgba(101, 67, 33, ${shade})`;
                    ctx.fillRect(x - size * 0.06, groundY - size * 0.6, size * 0.12, size * 0.6);
                    ctx.fillStyle = `rgba(34, 139, 34, ${shade * 0.8})`;
                    ctx.beginPath();
                    ctx.arc(x - size * 0.1, groundY - size * 0.6, size * 0.4, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = `rgba(50, 180, 50, ${shade * 0.9})`;
                    ctx.beginPath();
                    ctx.arc(x + size * 0.05, groundY - size * 0.7, size * 0.35, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = `rgba(40, 160, 40, ${shade * 0.85})`;
                    ctx.beginPath();
                    ctx.arc(x + size * 0.15, groundY - size * 0.55, size * 0.3, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = `rgba(60, 200, 60, ${shade * 0.5})`;
                    ctx.beginPath();
                    ctx.arc(x - size * 0.05, groundY - size * 0.5, size * 0.15, 0, Math.PI * 2);
                    ctx.fill();
                }

                for (const pine of this.pineTrees) {
                    const x = pine.x - camX * 0.18;
                    const size = pine.size;
                    const shade = pine.shade;
                    ctx.fillStyle = `rgba(101, 67, 33, ${shade * 0.7})`;
                    ctx.fillRect(x - size * 0.04, groundY - size * 0.5, size * 0.08, size * 0.5);
                    ctx.fillStyle = `rgba(34, 100, 34, ${shade * 0.8})`;
                    ctx.beginPath();
                    ctx.moveTo(x, groundY - size * 0.9);
                    ctx.lineTo(x - size * 0.4, groundY - size * 0.5);
                    ctx.lineTo(x + size * 0.4, groundY - size * 0.5);
                    ctx.fill();
                    ctx.fillStyle = `rgba(40, 130, 40, ${shade * 0.9})`;
                    ctx.beginPath();
                    ctx.moveTo(x, groundY - size * 1.0);
                    ctx.lineTo(x - size * 0.35, groundY - size * 0.6);
                    ctx.lineTo(x + size * 0.35, groundY - size * 0.6);
                    ctx.fill();
                }

                for (const log of this.logs) {
                    const lx = log.x - camX * 0.15;
                    const ly = log.y - camY * 0.05;
                    ctx.fillStyle = log.color;
                    ctx.beginPath();
                    ctx.ellipse(lx, ly, log.w / 2, log.h / 2, 0, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = 'rgba(0,0,0,0.1)';
                    ctx.beginPath();
                    ctx.ellipse(lx - 3, ly - 2, log.w / 4, log.h / 3, 0, 0, Math.PI * 2);
                    ctx.fill();
                }

                for (const bush of this.bushes) {
                    const bx = bush.x - camX * 0.12;
                    const by = bush.y - camY * 0.04;
                    const size = bush.size;
                    ctx.fillStyle = `rgba(34, 139, 34, ${bush.shade * 0.7})`;
                    ctx.beginPath();
                    ctx.arc(bx, by, size * 0.5, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = `rgba(50, 180, 50, ${bush.shade * 0.8})`;
                    ctx.beginPath();
                    ctx.arc(bx + size * 0.3, by - size * 0.1, size * 0.4, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = `rgba(60, 200, 60, ${bush.shade * 0.5})`;
                    ctx.beginPath();
                    ctx.arc(bx - size * 0.2, by - size * 0.2, size * 0.3, 0, Math.PI * 2);
                    ctx.fill();
                }

                for (const mush of this.mushrooms) {
                    const mx = mush.x - camX * 0.1;
                    const my = mush.y - camY * 0.03;
                    ctx.fillStyle = '#e8d5b5';
                    ctx.beginPath();
                    ctx.ellipse(mx, my + 2, mush.size * 0.2, mush.size * 0.3, 0, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = mush.color;
                    ctx.beginPath();
                    ctx.ellipse(mx, my - 2, mush.size * 0.4, mush.size * 0.25, 0, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = 'rgba(255,255,255,0.4)';
                    ctx.beginPath();
                    ctx.arc(mx - mush.size * 0.1, my - 4, mush.size * 0.08, 0, Math.PI * 2);
                    ctx.fill();
                }

                for (const rock of this.rocks) {
                    const rx = rock.x - camX * 0.08;
                    const ry = rock.y - camY * 0.02;
                    ctx.fillStyle = rock.color;
                    ctx.beginPath();
                    ctx.ellipse(rx, ry, rock.size, rock.size * 0.6, 0, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = 'rgba(0,0,0,0.05)';
                    ctx.beginPath();
                    ctx.ellipse(rx - 2, ry - 3, rock.size * 0.3, rock.size * 0.2, 0, 0, Math.PI * 2);
                    ctx.fill();
                }

                for (const b of this.butterflies) {
                    const bx = b.x - camX * 0.1;
                    const by = b.y - camY * 0.05;
                    const s = Math.sin(this.time * 0.5 + b.phase) * 4;
                    ctx.fillStyle = b.color;
                    ctx.beginPath();
                    ctx.ellipse(bx - 4 - s, by, 4, 2, 0, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.beginPath();
                    ctx.ellipse(bx + 4 + s, by, 4, 2, 0, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = 'rgba(0,0,0,0.3)';
                    ctx.beginPath();
                    ctx.ellipse(bx, by, 1, 3, 0, 0, Math.PI * 2);
                    ctx.fill();
                }

                const grassGrad = ctx.createLinearGradient(0, groundY, 0, H);
                grassGrad.addColorStop(0, '#4caf50');
                grassGrad.addColorStop(0.3, '#388e3c');
                grassGrad.addColorStop(1, '#2e7d32');
                ctx.fillStyle = grassGrad;
                ctx.fillRect(0, groundY, W, 30);
                for (let i = 0; i < W; i += 3) {
                    const height = 2 + Math.sin(i * 0.5 + this.time * 0.5) * 2;
                    const shade = 0.7 + Math.sin(i * 0.3) * 0.3;
                    ctx.fillStyle = `rgba(76, 175, 80, ${shade})`;
                    ctx.fillRect(i, groundY - height, 1, height);
                }

                for (const flower of this.flowers) {
                    const fx = flower.x - camX * 0.05;
                    const fy = flower.y - camY * 0.02;
                    ctx.fillStyle = flower.color;
                    ctx.beginPath();
                    ctx.arc(fx, fy, flower.size, 0, Math.PI * 2);
                    ctx.fill();
                    ctx.fillStyle = 'rgba(255,255,100,0.7)';
                    ctx.beginPath();
                    ctx.arc(fx, fy, flower.size * 0.3, 0, Math.PI * 2);
                    ctx.fill();
                }

                for (const p of this.particles) {
                    const px = p.x - camX * 0.02;
                    const py = p.y - camY * 0.01;
                    ctx.fillStyle = `rgba(200,200,180,${0.3 * (p.life / p.maxLife)})`;
                    ctx.beginPath();
                    ctx.arc(px, py, p.size * (p.life / p.maxLife), 0, Math.PI * 2);
                    ctx.fill();
                }
            }
        }

        // ============================================================
        // GAME MANAGER
        // ============================================================
        function checkCollision(a, b) {
            return a.x < b.x + b.width &&
                a.x + a.width > b.x &&
                a.y < b.y + b.height &&
                a.y + a.height > b.y;
        }

        class Platform {
            constructor(x, y, width, height, type, emoji) {
                this.x = x;
                this.y = y;
                this.width = width;
                this.height = height;
                this.type = type; // 'ground', 'log', 'rock'
                this.emoji = emoji;
            }
            draw(ctx, camX, camY, sceneTime) {
                const px = this.x - camX,
                    py = this.y - camY;
                if (this.type === 'log') {
                    ctx.fillStyle = '#8d6e63';
                    ctx.shadowColor = 'rgba(0,0,0,0.2)';
                    ctx.shadowBlur = 8;
                    ctx.shadowOffsetY = 3;
                    ctx.beginPath();
                    ctx.ellipse(px + this.width / 2, py + this.height / 2, this.width / 2, this.height / 2, 0, 0, Math
                        .PI * 2);
                    ctx.fill();
                    ctx.fillStyle = 'rgba(101, 67, 33, 0.5)';
                    ctx.beginPath();
                    ctx.ellipse(px + this.width / 2 - 4, py + this.height / 2 - 3, this.width / 4, this.height / 3, 0,
                        0, Math.PI * 2);
                    ctx.fill();
                    ctx.shadowBlur = 0;
                    ctx.shadowOffsetY = 0;
                } else if (this.type === 'rock') {
                    ctx.fillStyle = '#9e9e9e';
                    ctx.shadowColor = 'rgba(0,0,0,0.2)';
                    ctx.shadowBlur = 8;
                    ctx.shadowOffsetY = 3;
                    ctx.beginPath();
                    ctx.ellipse(px + this.width / 2, py + this.height / 2, this.width / 2, this.height / 2, 0, 0, Math
                        .PI * 2);
                    ctx.fill();
                    ctx.fillStyle = 'rgba(120,120,120,0.4)';
                    ctx.beginPath();
                    ctx.ellipse(px + this.width / 2 - 3, py + this.height / 2 - 4, this.width / 3, this.height / 3, 0,
                        0, Math.PI * 2);
                    ctx.fill();
                    ctx.shadowBlur = 0;
                    ctx.shadowOffsetY = 0;
                } else { // 'ground'
                    ctx.fillStyle = '#4caf50';
                    ctx.fillRect(px, py, this.width, this.height);
                    ctx.fillStyle = '#388e3c';
                    for (let i = 0; i < this.width; i += 10) {
                        const h = 2 + Math.sin(i * 0.3 + sceneTime) * 2;
                        ctx.fillRect(px + i, py - h, 2, h);
                    }
                }
            }
        }

        class Item {
            constructor(type, x, y, emoji) {
                this.type = type; // 'bones', 'coins', 'hearts'
                this.x = x;
                this.y = y;
                this.width = 28;
                this.height = 28;
                this.emoji = emoji;
                this.collected = false;
            }
            draw(ctx, camX, camY) {
                if (this.collected) return;
                const ix = this.x - camX,
                    iy = this.y - camY;
                ctx.font = 'bold 30px Arial';
                ctx.fillText(this.emoji, ix - 10, iy + 25);
            }
            collect(player) {
                if (this.collected) return false;
                if (checkCollision(player, this)) {
                    this.collected = true;
                    return true;
                }
                return false;
            }
        }

        class Enemy {
            constructor(x, y, startX, emoji = '👾', hp = 30) {
                this.x = x;
                this.y = y;
                this.width = 30;
                this.height = 30;
                this.startX = startX !== undefined ? startX : x;
                this.velX = (Math.random() > 0.5 ? 1 : -1) * (1.0 + Math.random() * 0.8);
                this.emoji = emoji;
                this.hp = hp;
                this.maxHp = hp;
                this.alive = true;
            }
            update(worldWidth) {
                if (!this.alive) return;
                this.x += this.velX;
                if (this.x < 0 || this.x > worldWidth) this.velX *= -1;
                if (Math.abs(this.x - this.startX) > 200) this.velX *= -1;
            }
            draw(ctx, camX, camY) {
                if (!this.alive) return;
                const ex = this.x - camX,
                    ey = this.y - camY;
                ctx.font = 'bold 35px Arial';
                ctx.fillText(this.emoji, ex - 10, ey + 25);
                const barW = 40,
                    barH = 4;
                const hpP = this.hp / this.maxHp;
                ctx.fillStyle = 'rgba(0,0,0,0.3)';
                ctx.fillRect(ex - 5, ey - 15, barW, barH);
                ctx.fillStyle = hpP > 0.5 ? '#4caf50' : hpP > 0.25 ? '#ff9800' : '#ff1744';
                ctx.fillRect(ex - 5, ey - 15, barW * hpP, barH);
            }
            // O jogador derrota o inimigo pisando nele por cima (queda)
            isPlayerStomping(player) {
                return player.velY > 0 && (player.y + player.height / 2) < (this.y + this.height / 2);
            }
            takeDamage(dmg) {
                this.hp -= dmg;
                if (this.hp <= 0) {
                    this.alive = false;
                    return true; // derrotado
                }
                return false;
            }
        }

        class Door {
            constructor(x, y, width = 40, height = 60) {
                this.x = x;
                this.y = y;
                this.width = width;
                this.height = height;
                this.isOpen = false;
            }
            checkOpen(hud) {
                this.isOpen = hud.isComplete();
                return this.isOpen;
            }
            draw(ctx, camX, camY) {
                const fx = this.x - camX,
                    fy = this.y - camY;
                const emoji = this.isOpen ? '🏆' : '🏁';
                ctx.font = 'bold 60px Arial';
                ctx.fillText(emoji, fx, fy + 55);
                if (this.isOpen) {
                    ctx.shadowColor = '#ffb300';
                    ctx.shadowBlur = 30;
                    ctx.fillText('✨', fx - 10, fy + 20);
                    ctx.shadowBlur = 0;
                }
            }
        }

        class HUD {
            constructor(stats, requirements) {
                this.stats = stats;
                this.requirements = requirements;
            }
            isComplete() {
                const req = this.requirements,
                    stats = this.stats;
                return stats.bones >= req.bones &&
                    stats.coins >= req.coins &&
                    stats.hearts >= req.hearts &&
                    stats.kills >= req.kills;
            }
            draw() { this.render(); }
            render() {
                const req = this.requirements,
                    stats = this.stats;
                document.getElementById('quest-bones-count').textContent = `${stats.bones}/${req.bones}`;
                document.getElementById('quest-coins-count').textContent = `${stats.coins}/${req.coins}`;
                document.getElementById('quest-hearts-count').textContent = `${stats.hearts}/${req.hearts}`;
                document.getElementById('quest-kills-count').textContent = `${stats.kills}/${req.kills}`;

                document.getElementById('quest-bones').classList.toggle('completed', stats.bones >= req.bones);
                document.getElementById('quest-coins').classList.toggle('completed', stats.coins >= req.coins);
                document.getElementById('quest-hearts').classList.toggle('completed', stats.hearts >= req.hearts);
                document.getElementById('quest-kills').classList.toggle('completed', stats.kills >= req.kills);

                const total = req.bones + req.coins + req.hearts + req.kills;
                const done = Math.min(stats.bones, req.bones) + Math.min(stats.coins, req.coins) +
                    Math.min(stats.hearts, req.hearts) + Math.min(stats.kills, req.kills);
                const pct = total > 0 ? Math.round((done / total) * 100) : 0;
                document.getElementById('hud-progress').textContent = pct + '%';
                document.getElementById('hud-bones').textContent = stats.bones;
                document.getElementById('hud-coins').textContent = stats.coins;
                document.getElementById('hud-hearts').textContent = stats.hearts;
                document.getElementById('hud-hp').textContent = stats.health;
            }
        }

        class GameManager {
            constructor(phase, character) {
                this.phase = phase;
                this.character = character;
                this.canvas = document.getElementById('game-canvas');
                this.ctx = this.canvas.getContext('2d');
                this.paused = false;
                this.gameOver = false;
                this.missionCompleteShown = false;
                this.particles = [];
                this.damageTexts = [];
                this.phaseTime = 0;
                this.running = true;

                this.resizeCanvas();
                window.addEventListener('resize', () => this.resizeCanvas());

                this.scenario = new Scenario(this.canvas);
                this.camera = { x: 0, y: 0 };

                this.player = null;
                this.platforms = [];
                this.enemies = [];
                this.collectibles = [];
                this.door = null;
                this.missionCompleteTriggered = false;
                this.checkpoints = [];

                this.keys = {};
                this.setupControls();

                this.requirements = { bones: 15, coins: 20, hearts: 3, kills: 5 };
                this.stats = { bones: 0, coins: 0, hearts: 0, kills: 0, health: 5, score: 0 };
                this.hud = new HUD(this.stats, this.requirements);

                this.initializeLevel();
                this.updateQuestHUD();
                this.startGameLoop();

                console.log('🌿 Fase', phase, 'iniciada');
            }

            resizeCanvas() {
                const rect = this.canvas.parentElement.getBoundingClientRect();
                this.canvas.width = rect.width || window.innerWidth;
                this.canvas.height = rect.height || window.innerHeight;
            }

            setupControls() {
                const keydown = (e) => {
                    const c = settings.controls;
                    if (e.key === c.moveLeft || e.key === 'ArrowLeft') { this.keys.left = true;
                        e.preventDefault(); }
                    if (e.key === c.moveRight || e.key === 'ArrowRight') { this.keys.right = true;
                        e.preventDefault(); }
                    if (e.key === c.jump || e.key === ' ') { this.keys.jump = true;
                        e.preventDefault(); }
                    if (e.key === c.run || e.key === 'Shift') this.keys.run = true;
                    if (e.key.toLowerCase() === c.pause.toLowerCase()) this.togglePause();
                    if (e.key.toLowerCase() === c.memory.toLowerCase()) this.showMemory();
                };
                const keyup = (e) => {
                    const c = settings.controls;
                    if (e.key === c.moveLeft || e.key === 'ArrowLeft') this.keys.left = false;
                    if (e.key === c.moveRight || e.key === 'ArrowRight') this.keys.right = false;
                    if (e.key === c.jump || e.key === ' ') this.keys.jump = false;
                    if (e.key === c.run || e.key === 'Shift') this.keys.run = false;
                };
                document.addEventListener('keydown', keydown);
                document.addEventListener('keyup', keyup);
            }

            initializeLevel() {
                const charData = CHARACTERS[this.character] || CHARACTERS.fifi;
                const groundY = this.canvas.height - 30;
                const worldWidth = this.canvas.width * 2;

                this.stats.bones = 0;
                this.stats.coins = 0;
                this.stats.hearts = 0;
                this.stats.kills = 0;
                this.stats.health = 5;
                this.missionCompleteShown = false;
                this.phaseTime = 0;
                document.getElementById('mission-complete').classList.remove('show');

                this.player = {
                    x: 80,
                    y: groundY - 50,
                    width: 40,
                    height: 50,
                    velX: 0,
                    velY: 0,
                    grounded: false,
                    emoji: charData.emoji,
                    speed: charData.speed,
                    jumpPower: charData.jumpPower,
                    attackPower: charData.attack,
                    direction: 1
                };

                this.platforms = [];
                this.platforms.push(new Platform(0, groundY, worldWidth, 30, 'ground', '🌿'));

                const platforms = [
                    { x: 200, y: groundY - 80, w: 80, h: 20, type: 'log', emoji: '🪵' },
                    { x: 350, y: groundY - 140, w: 100, h: 20, type: 'log', emoji: '🪵' },
                    { x: 520, y: groundY - 100, w: 60, h: 25, type: 'rock', emoji: '🪨' },
                    { x: 680, y: groundY - 160, w: 90, h: 20, type: 'log', emoji: '🪵' },
                    { x: 850, y: groundY - 120, w: 70, h: 20, type: 'log', emoji: '🪵' },
                    { x: 1000, y: groundY - 180, w: 100, h: 20, type: 'log', emoji: '🪵' },
                    { x: 1180, y: groundY - 130, w: 60, h: 25, type: 'rock', emoji: '🪨' },
                    { x: 1320, y: groundY - 190, w: 90, h: 20, type: 'log', emoji: '🪵' },
                    { x: 1500, y: groundY - 150, w: 80, h: 20, type: 'log', emoji: '🪵' },
                    { x: 1680, y: groundY - 200, w: 100, h: 20, type: 'log', emoji: '🪵' },
                    { x: 1860, y: groundY - 140, w: 70, h: 20, type: 'log', emoji: '🪵' },
                    { x: 2020, y: groundY - 170, w: 80, h: 20, type: 'log', emoji: '🪵' },
                ];
                for (const p of platforms) {
                    this.platforms.push(new Platform(p.x, p.y, p.w, p.h, p.type, p.emoji));
                }

                this.collectibles = [];
                for (let i = 0; i < 15; i++) {
                    let x = 120 + i * 100 + Math.sin(i * 0.7) * 30;
                    let y = groundY - 30 - Math.random() * 15;
                    if (i % 3 === 0 && i < platforms.length) {
                        const plat = platforms[i % platforms.length];
                        x = plat.x + plat.w / 2;
                        y = plat.y - 15;
                    }
                    this.collectibles.push(new Item('bones', x, y, '🦴'));
                }
                for (let i = 0; i < 20; i++) {
                    let x = 150 + i * 70 + Math.sin(i * 0.5) * 20;
                    let y = groundY - 40 - Math.sin(i * 0.8) * 30 - 10;
                    if (i % 4 === 0) {
                        const idx = Math.floor(i / 4) % platforms.length;
                        if (platforms[idx]) {
                            x = platforms[idx].x + platforms[idx].w / 2;
                            y = platforms[idx].y - 20;
                        }
                    }
                    this.collectibles.push(new Item('coins', x, y, '🪙'));
                }
                const heartPositions = [
                    { x: 450, y: groundY - 170 },
                    { x: 1100, y: groundY - 210 },
                    { x: 1750, y: groundY - 230 }
                ];
                for (const pos of heartPositions) {
                    this.collectibles.push(new Item('hearts', pos.x, pos.y, '❤️'));
                }

                this.enemies = [];
                const enemyPositions = [
                    { x: 400, y: groundY - 40 },
                    { x: 750, y: groundY - 40 },
                    { x: 1150, y: groundY - 50 },
                    { x: 1550, y: groundY - 40 },
                    { x: 1950, y: groundY - 50 }
                ];
                for (const pos of enemyPositions) {
                    this.enemies.push(new Enemy(pos.x, pos.y, pos.x, '👾', 30));
                }

                this.door = new Door(worldWidth - 120, groundY - 60, 40, 60);
                this.missionCompleteTriggered = false;

                this.checkpoints = [];
                for (let i = 0; i < 3; i++) {
                    this.checkpoints.push({ x: 300 + i * 600, y: groundY - 20, width: 20, height: 30, activated: false,
                        emoji: '🚩' });
                }
                this.activeCheckpoint = null;

                this.updateHUD();
                this.updateQuestHUD();
            }

            spawnParticles(x, y, color, count = 15, spread = 30) {
                for (let i = 0; i < count; i++) {
                    const angle = Math.random() * 2 * Math.PI;
                    const speed = 2 + Math.random() * 4;
                    this.particles.push({
                        x: x,
                        y: y,
                        vx: Math.cos(angle) * speed,
                        vy: Math.sin(angle) * speed - 1,
                        life: 30 + Math.random() * 20,
                        maxLife: 50,
                        size: 4 + Math.random() * 6,
                        color: color
                    });
                }
            }

            updateQuestHUD() {
                this.hud.render();
            }

            checkMissionComplete() {
                return this.hud.isComplete();
            }

            update() {
                if (this.paused || this.gameOver || !this.running) return;
                this.phaseTime += 1 / 60;

                const groundY = this.canvas.height - 30;
                const worldWidth = this.canvas.width * 2;

                try {
                    this.scenario.update();

                    const speedMul = this.keys.run ? 1.5 : 1;
                    if (this.keys.left) { this.player.velX = -this.player.speed * speedMul;
                        this.player.direction = -1; } else if (this.keys.right) { this.player.velX = this.player.speed *
                            speedMul;
                        this.player.direction = 1; } else { this.player.velX *= 0.85; }
                    const maxSpeed = this.player.speed * 1.8;
                    this.player.velX = Math.max(-maxSpeed, Math.min(maxSpeed, this.player.velX));
                    this.player.velY += 0.55;
                    this.player.x += this.player.velX;
                    this.player.y += this.player.velY;

                    if (Math.abs(this.player.velX) > 1 && this.player.grounded && Math.random() < 0.3) {
                        this.spawnParticles(this.player.x + this.player.width / 2, this.player.y + this.player.height,
                            'rgba(200,200,180,0.5)', 2, 10);
                    }

                    this.player.grounded = false;
                    for (const p of this.platforms) {
                        if (this.player.velY >= 0 &&
                            this.player.y + this.player.height >= p.y &&
                            this.player.y + this.player.height <= p.y + 25 &&
                            this.player.x + this.player.width > p.x &&
                            this.player.x < p.x + p.width) {
                            this.player.velY = 0;
                            this.player.y = p.y - this.player.height;
                            this.player.grounded = true;
                        }
                    }

                    if (this.keys.jump && this.player.grounded) {
                        this.player.velY = -this.player.jumpPower;
                        this.player.grounded = false;
                        this.keys.jump = false;
                        settings.audio.jump();
                        this.spawnParticles(this.player.x + this.player.width / 2, this.player.y + this.player.height,
                            'rgba(200,200,180,0.4)', 5, 15);
                    }

                    if (this.player.x < 0) this.player.x = 0;
                    if (this.player.x + this.player.width > worldWidth) this.player.x = worldWidth - this.player.width;

                    if (this.player.y > this.canvas.height + 100) {
                        this.stats.health--;
                        if (this.stats.health <= 0) { this.gameOver = true;
                            this.showGameOver(); } else {
                            if (this.activeCheckpoint) {
                                this.player.x = this.activeCheckpoint.x;
                                this.player.y = this.activeCheckpoint.y - this.player.height;
                            } else {
                                this.player.x = 80;
                                this.player.y = groundY - 50;
                            }
                            this.player.velY = 0;
                            this.player.velX = 0;
                            settings.audio.hurt();
                        }
                        this.updateHUD();
                    }

                    for (const cp of this.checkpoints) {
                        if (!cp.activated && this.player.x + this.player.width > cp.x &&
                            this.player.x < cp.x + cp.width &&
                            this.player.y + this.player.height > cp.y &&
                            this.player.y < cp.y + cp.height) {
                            cp.activated = true;
                            this.activeCheckpoint = cp;
                            settings.audio.collectCoin();
                            this.spawnParticles(cp.x + cp.width / 2, cp.y, '#ffb300', 20, 30);
                        }
                    }

                    for (let i = this.enemies.length - 1; i >= 0; i--) {
                        const e = this.enemies[i];
                        if (!e.alive) continue;
                        e.update(worldWidth);

                        if (checkCollision(this.player, e)) {
                            if (e.isPlayerStomping(this.player)) {
                                const dmg = this.player.attackPower + Math.abs(this.player.velY) * 1.5;
                                const killed = e.takeDamage(dmg);
                                this.player.velY = -8;
                                this.damageTexts.push({ x: e.x, y: e.y - 30, text: '-' + Math.floor(dmg), life: 30 });
                                this.spawnParticles(e.x, e.y, '#ff6b6b', 15, 25);
                                settings.audio.enemyKilled();
                                if (killed) {
                                    this.stats.kills++;
                                    this.stats.score += 150;
                                    this.spawnParticles(e.x, e.y, '#ffb300', 25, 35);
                                    this.hud.render();
                                    if (this.hud.isComplete() && !this.missionCompleteShown) {
                                        this.missionCompleteShown = true;
                                        this.showMissionComplete();
                                    }
                                }
                            } else {
                                this.stats.health--;
                                this.player.x = 80;
                                this.player.y = groundY - 50;
                                this.player.velY = 0;
                                this.player.velX = 0;
                                this.spawnParticles(this.player.x, this.player.y, '#ff1744', 10);
                                settings.audio.hurt();
                                if (this.stats.health <= 0) { this.gameOver = true;
                                    this.showGameOver(); }
                                this.hud.render();
                            }
                        }
                    }
                    this.enemies = this.enemies.filter(e => e.alive);

                    for (let i = this.collectibles.length - 1; i >= 0; i--) {
                        const item = this.collectibles[i];
                        if (item.collect(this.player)) {
                            this.stats[item.type] = (this.stats[item.type] || 0) + 1;
                            this.stats.score += item.type === 'bones' ? 50 : item.type === 'coins' ? 75 : 100;
                            const colors = { bones: '#ffb300', coins: '#ffd700', hearts: '#ff1744' };
                            this.spawnParticles(item.x, item.y, colors[item.type] || '#fff', 15, 25);
                            if (item.type === 'hearts') {
                                this.stats.health = Math.min(this.stats.health + 1, 5);
                                settings.audio.collectHeart();
                            } else if (item.type === 'coins') {
                                settings.audio.collectCoin();
                            } else {
                                settings.audio.collectBone();
                            }
                            this.hud.render();
                            if (this.hud.isComplete() && !this.missionCompleteShown) {
                                this.missionCompleteShown = true;
                                this.showMissionComplete();
                            }
                            this.collectibles.splice(i, 1);
                        }
                    }

                    this.door.checkOpen(this.hud);
                    const touchingDoor = checkCollision(this.player, this.door);

                    if (touchingDoor) {
                        if (this.door.isOpen) {
                            if (!this.missionCompleteTriggered) {
                                this.missionCompleteTriggered = true;
                                settings.audio.victory();
                                this.spawnParticles(this.door.x + this.door.width / 2, this.door.y, '#ffb300', 40, 50);
                                this.showMissionComplete();
                            }
                        } else {
                            const missing = [];
                            const req = this.requirements;
                            const stats = this.stats;
                            if (stats.bones < req.bones) missing.push('🦴 ossos');
                            if (stats.coins < req.coins) missing.push('🪙 moedas');
                            if (stats.hearts < req.hearts) missing.push('❤️ corações');
                            if (stats.kills < req.kills) missing.push('👾 inimigos');
                            this.showToast(`⚠️ Faltam: ${missing.join(', ')}`);
                        }
                    }

                    this.particles = this.particles.filter(p => p.life > 0);
                    for (const p of this.particles) {
                        p.x += p.vx;
                        p.y += p.vy;
                        p.vy += 0.05;
                        p.life--;
                    }

                    this.damageTexts = this.damageTexts.filter(t => t.life > 0);
                    for (const t of this.damageTexts) t.life--;

                    this.updateCamera();
                } catch (err) {
                    console.error('Erro no update:', err);
                }
            }

            isColliding(a, b) {
                return checkCollision(a, b);
            }

            updateCamera() {
                const tx = this.player.x - this.canvas.width / 2 + this.player.width / 2;
                const ty = this.player.y - this.canvas.height / 2 + this.player.height / 2;
                this.camera.x += (tx - this.camera.x) * 0.08;
                this.camera.y += (ty - this.camera.y) * 0.08;
                const maxX = this.canvas.width * 2 - this.canvas.width;
                this.camera.x = Math.max(0, Math.min(maxX, this.camera.x));
                this.camera.y = Math.max(0, Math.min(0, this.camera.y));
            }

            draw() {
                const ctx = this.ctx;
                const cam = this.camera;
                const W = this.canvas.width,
                    H = this.canvas.height;

                if (W === 0 || H === 0) return;

                ctx.clearRect(0, 0, W, H);

                try {
                    this.scenario.draw(cam.x, cam.y);

                    for (const p of this.platforms) {
                        p.draw(ctx, cam.x, cam.y, this.scenario.time);
                    }

                    for (const cp of this.checkpoints) {
                        const cx = cp.x - cam.x,
                            cy = cp.y - cam.y;
                        ctx.font = '28px Arial';
                        ctx.fillText(cp.activated ? '🏁' : '🚩', cx, cy + 25);
                    }

                    for (const item of this.collectibles) {
                        item.draw(ctx, cam.x, cam.y);
                    }

                    for (const e of this.enemies) {
                        e.draw(ctx, cam.x, cam.y);
                    }

                    this.door.draw(ctx, cam.x, cam.y);

                    const px = this.player.x - cam.x,
                        py = this.player.y - cam.y;
                    ctx.save();
                    ctx.font = 'bold 50px Arial';
                    if (this.player.direction === 1) {
                        ctx.translate(px + this.player.width / 2, py);
                        ctx.scale(-1, 1);
                        ctx.translate(-(this.player.width / 2), 0);
                        ctx.fillText(this.player.emoji, 0, 40);
                    } else {
                        ctx.fillText(this.player.emoji, px, py + 40);
                    }
                    if (this.character === 'fifi') { ctx.font = '18px Arial';
                        ctx.fillStyle = '#ff6b9d';
                        ctx.fillText('💗', this.player.direction === 1 ? -10 : 30, 20); }
                    if (this.character === 'pretinha') { ctx.font = '20px Arial';
                        ctx.fillStyle = '#ff1744';
                        ctx.fillText('❤️', this.player.direction === 1 ? -10 : 30, 20); }
                    ctx.restore();

                    for (const p of this.particles) {
                        const alpha = p.life / p.maxLife;
                        ctx.globalAlpha = alpha;
                        ctx.fillStyle = p.color;
                        ctx.beginPath();
                        ctx.arc(p.x - cam.x, p.y - cam.y, p.size * alpha, 0, Math.PI * 2);
                        ctx.fill();
                    }
                    ctx.globalAlpha = 1;

                    for (const t of this.damageTexts) {
                        const dx = t.x - cam.x,
                            dy = t.y - cam.y;
                        ctx.save();
                        ctx.font = 'bold 24px Arial';
                        ctx.fillStyle = `rgba(255, 50, 50, ${t.life / 30})`;
                        ctx.fillText(t.text, dx, dy - (30 - t.life) * 2);
                        ctx.restore();
                    }
                } catch (err) {
                    console.error('Erro no draw:', err);
                }
            }

            startGameLoop() {
                const loop = () => {
                    if (!this.running) return;
                    try {
                        this.update();
                        this.draw();
                    } catch (err) {
                        console.error('Erro no loop:', err);
                    }
                    requestAnimationFrame(loop);
                };
                loop();
            }

            togglePause() { this.paused = !this.paused;
                document.getElementById('pause-overlay').classList.toggle('active'); }
            showMemory() { if (!this.paused && !this.gameOver) { this.paused = true;
                    document.getElementById('memory-overlay').classList.add('active'); } }

            showToast(msg) {
                const el = document.getElementById('mission-complete');
                el.querySelector('h2').textContent = '⚠️ ' + msg;
                el.querySelector('p').textContent = 'Continue explorando!';
                el.classList.add('show');
                setTimeout(() => el.classList.remove('show'), 2500);
            }

            showMissionComplete() {
                const el = document.getElementById('mission-complete');
                el.querySelector('h2').textContent = '🏆 MISSÃO CONCLUÍDA!';
                el.querySelector('p').innerHTML =
                    `⏱️ ${Math.floor(this.phaseTime)}s &nbsp;|&nbsp; 🦴 ${this.stats.bones} &nbsp;|&nbsp; 🪙 ${this.stats.coins} &nbsp;|&nbsp; ❤️ ${this.stats.hearts} &nbsp;|&nbsp; 👾 ${this.stats.kills}`;
                el.classList.add('show');
                settings.audio.victory();

                this.saveProgress();

                // FIX: Aguardar 3 segundos e então chamar a transição
                setTimeout(() => {
                    el.classList.remove('show');
                    const nextPhase = this.phase + 1;
                    if (nextPhase <= 15) {
                        this.transitionToNextPhase(nextPhase);
                    } else {
                        document.getElementById('game-over').classList.add('active');
                        document.getElementById('go-title').textContent = '🏆 JOGO COMPLETO!';
                        document.getElementById('go-sub').textContent = 'Parabéns, você salvou todos os animais!';
                        document.getElementById('go-next').textContent = '🏠 MENU';
                        document.getElementById('go-next').onclick = () => backToMenu();
                        this.gameOver = true;
                    }
                }, 3000);
            }

            transitionToNextPhase(nextPhase) {
                // FIX: Parar o jogo antigo ANTES de criar o novo
                if (gameManager && gameManager !== this) {
                    gameManager.running = false;
                }
                this.running = false;

                const overlay = document.getElementById('transition-overlay');
                overlay.classList.add('active');

                setTimeout(() => {
                    // Remover qualquer overlay pendente
                    document.getElementById('mission-complete').classList.remove('show');
                    document.getElementById('game-over').classList.remove('active');

                    // Iniciar a nova fase
                    startGame(nextPhase, this.character);

                    setTimeout(() => {
                        overlay.classList.remove('active');
                    }, 300);
                }, 600);
            }

            saveProgress() {
                settings.stats.totalBones += this.stats.bones;
                settings.stats.totalCoins += this.stats.coins;
                settings.stats.totalHearts += this.stats.hearts;
                settings.stats.totalKills += this.stats.kills;
                settings.stats.maxPhase = Math.max(settings.stats.maxPhase, this.phase + 1);
                settings.saveStats(settings.stats);
                settings.unlock(this.character);
                localStorage.setItem('heroisDePatasSave', JSON.stringify({
                    phase: this.phase + 1,
                    character: this.character,
                    stats: this.stats
                }));
            }

            showGameOver() {
                document.getElementById('game-over').classList.add('active');
                document.getElementById('go-title').textContent = '💔 GAME OVER';
                document.getElementById('go-sub').textContent = 'Vidas esgotadas! Inimigos: ' + this.stats.kills;
                document.getElementById('go-next').textContent = '↻ TENTAR NOVAMENTE';
                document.getElementById('go-next').onclick = () => {
                    document.getElementById('game-over').classList.remove('active');
                    startGame(this.phase, this.character);
                };
            }

            updateHUD() {
                document.getElementById('hud-hp').textContent = this.stats.health;
                document.getElementById('hud-phase-name').textContent = 'Fase ' + this.phase;
            }
        }

        // ============================================================
        // INICIALIZAÇÃO
        // ============================================================
        let selectedChar = 'fifi';
        let gameManager = null;

        function startGame(phase, character) {
            // FIX: Parar e limpar o gameManager anterior
            if (gameManager) {
                gameManager.running = false;
                gameManager = null;
            }

            document.getElementById('menu-container').classList.add('hidden');
            document.getElementById('game-container').classList.remove('hidden');

            // Resetar overlays
            document.getElementById('pause-overlay').classList.remove('active');
            document.getElementById('game-over').classList.remove('active');
            document.getElementById('memory-overlay').classList.remove('active');
            document.getElementById('transition-overlay').classList.remove('active');
            document.getElementById('mission-complete').classList.remove('show');

            gameManager = new GameManager(phase, character);
            settings.unlock(character);
        }

        function backToMenu() {
            if (gameManager) {
                gameManager.running = false;
                gameManager = null;
            }
            document.getElementById('game-container').classList.add('hidden');
            document.getElementById('menu-container').classList.remove('hidden');
            document.getElementById('pause-overlay').classList.remove('active');
            document.getElementById('game-over').classList.remove('active');
            document.getElementById('memory-overlay').classList.remove('active');
            document.getElementById('transition-overlay').classList.remove('active');
            document.getElementById('mission-complete').classList.remove('show');
        }

        document.addEventListener('DOMContentLoaded', function() {
            initializeMenu();
            setupGameButtons();
            updateProgressScreen();
            console.log('🌿 Jogo v6.2 - Mudança de fase corrigida!');
        });

        function initializeMenu() {
            document.getElementById('btn-new-game').addEventListener('click', function() {
                const selected = document.querySelector('.char-card.selected') || document.querySelector(
                    '.char-card.main');
                selectedChar = selected ? selected.dataset.char : 'fifi';
                if (confirm(`🐾 Iniciar com ${CHARACTERS[selectedChar].name}?`)) {
                    localStorage.removeItem('heroisDePatasSave');
                    startGame(1, selectedChar);
                }
            });

            document.getElementById('btn-continue').addEventListener('click', function() {
                const saved = localStorage.getItem('heroisDePatasSave');
                if (saved) { try { const data = JSON.parse(saved);
                        startGame(data.phase || 1, data.character || 'fifi'); } catch (e) { alert('Erro!'); } } else alert(
                        'Nenhum jogo salvo!');
            });

            document.getElementById('btn-progress').addEventListener('click', function() {
                document.querySelector('#menu-content').classList.add('hidden');
                document.getElementById('progress-screen').classList.remove('hidden');
                updateProgressScreen();
            });
            document.getElementById('btn-back-progress').addEventListener('click', function() {
                document.getElementById('progress-screen').classList.add('hidden');
                document.querySelector('#menu-content').classList.remove('hidden');
            });

            document.getElementById('btn-tutorial').addEventListener('click', function() {
                document.querySelector('#menu-content').classList.add('hidden');
                document.getElementById('tutorial-screen').classList.remove('hidden');
            });
            document.getElementById('btn-back-tutorial').addEventListener('click', function() {
                document.getElementById('tutorial-screen').classList.add('hidden');
                document.querySelector('#menu-content').classList.remove('hidden');
            });

            document.getElementById('btn-credits').addEventListener('click', function() {
                document.querySelector('#menu-content').classList.add('hidden');
                document.getElementById('credits-screen').classList.remove('hidden');
            });
            document.getElementById('btn-back-credits').addEventListener('click', function() {
                document.getElementById('credits-screen').classList.add('hidden');
                document.querySelector('#menu-content').classList.remove('hidden');
            });

            document.getElementById('btn-characters').addEventListener('click', function() {
                document.querySelector('#menu-content').classList.add('hidden');
                document.getElementById('characters-screen').classList.remove('hidden');
            });
            document.getElementById('btn-back-characters').addEventListener('click', function() {
                document.getElementById('characters-screen').classList.add('hidden');
                document.querySelector('#menu-content').classList.remove('hidden');
            });

            document.querySelectorAll('.char-card').forEach(card => {
                card.addEventListener('click', function() {
                    document.querySelectorAll('.char-card').forEach(c => c.classList.remove('selected'));
                    this.classList.add('selected');
                    selectedChar = this.dataset.char;
                    localStorage.setItem('selectedCharacter', selectedChar);
                });
            });
            const savedChar = localStorage.getItem('selectedCharacter') || 'fifi';
            const card = document.querySelector(`.char-card[data-char="${savedChar}"]`);
            if (card) { card.classList.add('selected');
                selectedChar = savedChar; }
        }

        function setupGameButtons() {
            document.getElementById('btn-resume').addEventListener('click', function() { if (gameManager) gameManager
                    .togglePause(); });
            document.getElementById('btn-save').addEventListener('click', function() {
                if (gameManager) {
                    localStorage.setItem('heroisDePatasSave', JSON.stringify({
                        phase: gameManager.phase,
                        character: gameManager.character,
                        stats: gameManager.stats
                    }));
                    alert('💾 Jogo salvo!');
                }
            });
            document.getElementById('btn-menu').addEventListener('click', backToMenu);
            document.getElementById('btn-memory-continue').addEventListener('click', function() {
                document.getElementById('memory-overlay').classList.remove('active');
                if (gameManager) gameManager.paused = false;
            });
        }

        function updateProgressScreen() {
            const stats = settings.stats;
            const maxPhase = 15;
            const progress = Math.min((stats.maxPhase / maxPhase) * 100, 100);
            document.getElementById('progress-fill').style.width = progress + '%';
            document.getElementById('progress-fill').textContent = Math.floor(progress) + '%';
            document.getElementById('progress-bones').textContent = stats.totalBones;
            document.getElementById('progress-coins').textContent = stats.totalCoins;
            document.getElementById('progress-hearts').textContent = stats.totalHearts;
            document.getElementById('progress-kills').textContent = stats.totalKills;
            document.getElementById('progress-phase').textContent = stats.maxPhase;
        }

        console.log('🐾 HERÓIS DE PATAS v6.2');
        console.log('✅ Mudança de fase corrigida!');
        console.log('🎯 Complete todos os objetivos para avançar!');
    </script>
